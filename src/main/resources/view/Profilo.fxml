<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    =================================================================================
    SCHERMATA PROFILO UTENTE
    =================================================================================
    Visualizza i dettagli del profilo dell'utente loggato (nome, cognome, email, data iscrizione).
    Permette la modifica dell'email tramite un dialogo TextInputDialog.
    Fornisce accesso al menu profilo (Impostazioni, Logout).
    
    STRUTTURA PRINCIPALE:
    1. Navbar blu superiore con pulsante "Torna Dashboard" e MenuButton profilo
    2. Header con icona, titolo, sottotitolo e layout responsive
    3. Card principale bianca con i dettagli del profilo
    4. Pulsanti di azione (Modifica, Torna Indietro)
    5. Footer con dettagli aggiuntivi e separatori
-->
<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="900.0"
      stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProfiloController">
    <children>

        <!-- SEZIONE 1: NAVBAR SUPERIORE -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" styleClass="app-navbar">
            <children>
                <Button fx:id="btnTornaDashboard" onAction="#tornaAllaDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                        text="← Torna alla Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton fx:id="menuProfilo" styleClass="app-nav-button" text="👤 Ciao, Utente">
                    <items>
                        <MenuItem onAction="#apriProfiloMenu" text="👤 Il mio profilo" />
                        <MenuItem onAction="#apriImpostazioni" text="⚙️ Impostazioni" />
                        <MenuItem onAction="#gestisciLogout" text="🚪 Esci" />
                    </items>
                </MenuButton>
            </children>
            <padding><Insets left="25.0" right="25.0" top="10.0" bottom="10.0" /></padding>
        </HBox>

        <!-- SEZIONE 2: HEADER CON ICONA, TITOLO E SOTTOTITOLO -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="content-header">
            <children>
                <!-- Icona blu arrotondata con immagine user-account.png -->
                <StackPane maxHeight="48.0" maxWidth="48.0" prefHeight="48.0" prefWidth="48.0"
                           style="-fx-background-color: #1d4ed8; -fx-background-radius: 12px;">
                    <children>
                        <ImageView fitHeight="26.0" fitWidth="26.0" preserveRatio="true">
                            <image><Image url="@../images/icons/user-account.png" /></image>
                        </ImageView>
                    </children>
                </StackPane>

                <!-- Testo: titolo + sottotitolo -->
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="content-header-title" text="Il mio profilo" />
                        <Label styleClass="content-header-subtitle"
                               text="Gestisci le tue informazioni personali e visualizza il riepilogo delle tue patenti."
                               wrapText="true" maxWidth="500.0" />
                    </children>
                </VBox>
            </children>
            <padding><Insets left="40.0" right="40.0" top="20.0" bottom="20.0" /></padding>
        </HBox>

        <!-- SEZIONE 3: CARD PRINCIPALE CON I DETTAGLI DEL PROFILO -->
        <VBox VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
            <children>
                <VBox spacing="0.0" maxWidth="540.0" styleClass="profile-card">
                    <children>

                        <!-- Avatar grande centrato -->
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <StackPane maxHeight="90.0" maxWidth="90.0" prefHeight="90.0" prefWidth="90.0"
                                           style="-fx-background-color: #dbeafe; -fx-background-radius: 50%;">
                                    <children>
                                        <ImageView fitHeight="52.0" fitWidth="52.0" preserveRatio="true">
                                            <image><Image url="@../images/icons/user-account.png" /></image>
                                        </ImageView>
                                    </children>
                                </StackPane>

                                <Label fx:id="lblNomeCompleto" styleClass="profile-name" text="Cristian Fabbricatore" />

                                <Label fx:id="lblRuolo"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0284c7; -fx-background-color: #e0f2fe; -fx-background-radius: 20px; -fx-padding: 4px 14px;"
                                       text="Utente MyPatenti" />
                            </children>
                            <padding><Insets top="30.0" bottom="20.0" /></padding>
                        </VBox>

                        <Separator />

                        <!-- Sezione Campi Profilo: Nome, Cognome, Email, Data -->
                        <VBox spacing="0.0">
                            <children>

                                <!-- CAMPO NOME -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="profile-row-divider">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="profile-icon-box">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/icons/user-account.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label styleClass="profile-field-label" text="NOME" />
                                                <Label fx:id="lblNome" styleClass="profile-field-value" text="Cristian" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                                <!-- CAMPO COGNOME -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="profile-row-divider">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="profile-icon-box">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/icons/user-account.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label styleClass="profile-field-label" text="COGNOME" />
                                                <Label fx:id="lblCognome" styleClass="profile-field-value" text="Fabbricatore" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                                <!-- CAMPO EMAIL -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="profile-row-divider">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="profile-icon-box">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/icons/email.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label styleClass="profile-field-label" text="EMAIL" />
                                                <Label fx:id="lblEmail" styleClass="profile-field-value" text="cristian@example.com" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                                <!-- CAMPO DATA DI ISCRIZIONE -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="profile-icon-box">
                                            <children>
                                                <Label style="-fx-font-size: 16px;" text="📅" />
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label styleClass="profile-field-label" text="ISCRITTO DAL" />
                                                <Label fx:id="lblDataIscrizione" styleClass="profile-field-value" text="05/01/2026" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                            </children>
                        </VBox>

                        <Separator />

                        <!-- PULSANTI -->
                        <VBox spacing="10.0">
                            <children>
                                <Button fx:id="btnModifica" maxWidth="Infinity" onAction="#gestisciModificaProfilo"
                                        styleClass="profile-btn-modifica"
                                        text="✏  MODIFICA DATI" />
                                <Button fx:id="btnTornaIndietro" maxWidth="Infinity" onAction="#tornaAllaDashboard"
                                        styleClass="profile-btn-indietro"
                                        text="← TORNA INDIETRO" />
                            </children>
                            <padding><Insets top="22.0" bottom="28.0" left="28.0" right="28.0" /></padding>
                        </VBox>

                    </children>
                </VBox>
            </children>
            <padding><Insets top="24.0" left="40.0" right="40.0" bottom="30.0" /></padding>
        </VBox>

    </children>
</VBox>
