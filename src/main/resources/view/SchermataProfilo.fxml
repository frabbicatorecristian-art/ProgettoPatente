<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    =================================================================================
    SCHERMATA PROFILO UTENTE
    =================================================================================
    Visualizza i dettagli del profilo dell'utente loggato (nome, cognome, email, data iscrizione).
    Permette la modifica dell'email tramite un dialogo TextInputDialog.
    Fornisce accesso al menu profilo (Impostazioni, Logout).
    
    STRUTTURA PRINCIPALE:
    1. Navbar blu superiore con pulsante "Torna Dashboard" e MenuButton profilo
    2. Header con icona, titolo, sottotitolo e layout responsive
    3. Card principale bianca con i dettagli del profilo
    4. Pulsanti di azione (Modifica, Torna Indietro)
    5. Footer con dettagli aggiuntivi e separatori
-->
<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="900.0"
      style="-fx-background-color: #f1f5f9;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProfiloController">
    <children>

        <!--
            =============================================================================
            SEZIONE 1: NAVBAR SUPERIORE BLU
            =============================================================================
            HBox orizzontale con sfondo blu (#0284c7).
            Contiene:
            - Pulsante "Torna alla Dashboard" (fx:id="btnTornaDashboard")
              * onAction="#tornaAllaDashboard" → Chiama il metodo del controller quando clicato
              * style="-fx-background-color: transparent; -fx-text-fill: white;" → CSS inline per sfondo trasparente e testo bianco
            - Region vuoto con HBox.hgrow="ALWAYS" → Fa espandere il nodo orizzontalmente per spingere il menu a destra
            - MenuButton menu profilo (fx:id="menuProfilo")
              * Contains MenuItem per accedere a Profilo, Impostazioni, Logout
        -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0"
              style="-fx-background-color: #0284c7;">
            <children>
                <!-- Pulsante per tornare alla Dashboard -->
                <Button fx:id="btnTornaDashboard" onAction="#tornaAllaDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                        text="← Torna alla Dashboard" />
                <!-- Spaziatore flessibile: HBox.hgrow="ALWAYS" fa espandere il nodo orizzontalmente -->
                <Region HBox.hgrow="ALWAYS" />
                <!-- Menu profilo a discesa con opzioni -->
                <MenuButton fx:id="menuProfilo"
                            style="-fx-background-color: #0369a1; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                            text="👤 Ciao, Utente">
                    <items>
                        <MenuItem onAction="#apriProfiloMenu" text="👤 Il mio profilo" />
                        <MenuItem onAction="#apriImpostazioni" text="⚙️ Impostazioni" />
                        <MenuItem onAction="#gestisciLogout" text="🚪 Esci" />
                    </items>
                </MenuButton>
            </children>
            <padding><Insets left="25.0" right="25.0" top="10.0" bottom="10.0" /></padding>
        </HBox>

        <!-- =========================================================
             SEZIONE 2: HEADER CON ICONA, TITOLO E SOTTOTITOLO
             =========================================================
             HBox orizzontale con sfondo bianco e shadow.
             Struttura: icona blu arrotondata (StackPane) + testo (VBox con titolo/sottotitolo)
             Stile="dropshadow(...)" → Aggiunge un'ombra delicata sotto l'elemento
        -->
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 2);">
            <children>
                <!-- Icona blu arrotondata con immagine user-account.png -->
                <StackPane maxHeight="48.0" maxWidth="48.0" prefHeight="48.0" prefWidth="48.0"
                           style="-fx-background-color: #1d4ed8; -fx-background-radius: 12px;">
                    <children>
                        <ImageView fitHeight="26.0" fitWidth="26.0" preserveRatio="true">
                            <image><Image url="@../images/user-account.png" /></image>
                        </ImageView>
                    </children>
                </StackPane>

                <!-- Testo: titolo + sottotitolo -->
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <!-- Titolo della schermata -->
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                               text="Il mio profilo" />
                        <!-- Sottotitolo descrittivo -->
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;"
                               text="Gestisci le tue informazioni personali e visualizza il riepilogo delle tue patenti."
                               wrapText="true" maxWidth="500.0" />
                    </children>
                </VBox>
            </children>
            <padding><Insets left="40.0" right="40.0" top="20.0" bottom="20.0" /></padding>
        </HBox>

        <!--
            =============================================================================
            SEZIONE 3: CARD PRINCIPALE CON I DETTAGLI DEL PROFILO
            =============================================================================
            VBox con VBox.vgrow="ALWAYS" → Fa espandere il nodo verticalmente occupando tutto lo spazio disponibile
            Contiene:
            1. Avatar centrato (StackPane 90x90 con background celeste)
            2. Nome completo (Label - fx:id="lblNomeCompleto")
            3. Badge di ruolo (Label "Utente MyPatenti")
            4. Separator (linea orizzontale di divisione)
            5. Sezione Campi: Nome, Cognome, Email, Data Iscrizione (con icone)
            6. Separator
            7. Pulsanti di azione (Modifica, Torna Indietro)
        -->
        <VBox VBox.vgrow="ALWAYS" alignment="TOP_CENTER">
            <children>
                <VBox spacing="0.0" maxWidth="540.0"
                      style="-fx-background-color: white; -fx-background-radius: 16px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.07), 14, 0, 0, 3);">
                    <children>

                        <!-- Avatar grande centrato (StackPane 90x90 con background celeste) -->
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <!-- Avatar circolare con background celeste (#dbeafe) -->
                                <StackPane maxHeight="90.0" maxWidth="90.0" prefHeight="90.0" prefWidth="90.0"
                                           style="-fx-background-color: #dbeafe; -fx-background-radius: 50%;">
                                    <children>
                                        <ImageView fitHeight="52.0" fitWidth="52.0" preserveRatio="true">
                                            <image><Image url="@../images/user-account.png" /></image>
                                        </ImageView>
                                    </children>
                                </StackPane>

                                <!--
                                    Nome completo dell'utente loggato
                                    fx:id="lblNomeCompleto" → ID che collega questa Label al controller Java
                                    @FXML private Label lblNomeCompleto; → Viene popolo nel metodo initialize() del controller
                                -->
                                <Label fx:id="lblNomeCompleto"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                       text="Cristian Fabbricatore" />

                                <!--
                                    Badge di ruolo (es. "Utente MyPatenti")
                                    fx:id="lblRuolo" → ID per collegare al controller
                                    style="-fx-background-color: #e0f2fe;" → Background celeste (Tailwind Sky-100)
                                    style="-fx-background-radius: 20px;" → Arrotondamento dei bordi per pill-shaped badge
                                    style="-fx-padding: 4px 14px;" → Padding interno per distanziare il testo dai bordi
                                -->
                                <Label fx:id="lblRuolo"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0284c7; -fx-background-color: #e0f2fe; -fx-background-radius: 20px; -fx-padding: 4px 14px;"
                                       text="Utente MyPatenti" />
                            </children>
                            <padding><Insets top="30.0" bottom="20.0" /></padding>
                        </VBox>

                        <!-- Separator orizzontale: linea grigia che divide le sezioni -->
                        <Separator />

                        <!-- Sezione Campi Profilo: Nome, Cognome, Email (con icone grigie e bordi) -->
                        <VBox spacing="0.0">
                            <children>

                                <!--
                                    CAMPO NOME
                                    HBox orizzontale con spacing="16.0" → Spazia gli elementi di 16 pixel
                                    style="-fx-border-color: transparent transparent #e2e8f0 transparent;" → Bordo solo sotto (divider)
                                    style="-fx-border-width: 0 0 1 0;" → Larghezza bordo: 1px solo sotto
                                -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0"
                                      style="-fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                                    <children>
                                        <!-- Icona "nome" in un box arrotondato celeste -->
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   style="-fx-background-color: #eff6ff; -fx-background-radius: 10px;">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/user-account.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <!-- Testo: etichetta "NOME" + valore Nome -->
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <!-- Etichetta della sezione -->
                                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"
                                                       text="NOME" />
                                                <!--
                                                    Valore del nome dell'utente
                                                    fx:id="lblNome" → Collegato al controller per l'aggiornamento dinamico
                                                    @FXML private Label lblNome; → Nel controller, viene popolo in initialize()
                                                -->
                                                <Label fx:id="lblNome"
                                                       style="-fx-font-size: 14px; -fx-text-fill: #1e293b;"
                                                       text="Cristian" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                                <!--
                                    CAMPO COGNOME
                                    Struttura identica al campo NOME
                                -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0"
                                      style="-fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   style="-fx-background-color: #eff6ff; -fx-background-radius: 10px;">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/user-account.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"
                                                       text="COGNOME" />
                                                <!--
                                                    Valore del cognome dell'utente
                                                    fx:id="lblCognome" → ID che collega questa Label al controller Java
                                                -->
                                                <Label fx:id="lblCognome"
                                                       style="-fx-font-size: 14px; -fx-text-fill: #1e293b;"
                                                       text="Fabbricatore" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                                <!--
                                    CAMPO EMAIL
                                    Struttura simile ai precedenti, usa icona email.png
                                -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0"
                                      style="-fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   style="-fx-background-color: #eff6ff; -fx-background-radius: 10px;">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/email.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"
                                                       text="EMAIL" />
                                                <Label fx:id="lblEmail"
                                                       style="-fx-font-size: 14px; -fx-text-fill: #1e293b;"
                                                       text="cristian@example.com" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                                <!-- DATA ISCRIZIONE (dalla prima bozza) -->
                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                    <children>
                                        <StackPane maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                                                   style="-fx-background-color: #eff6ff; -fx-background-radius: 10px;">
                                            <children>
                                                <Label style="-fx-font-size: 16px;" text="📅" />
                                            </children>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;"
                                                       text="ISCRITTO DAL" />
                                                <Label fx:id="lblDataIscrizione"
                                                       style="-fx-font-size: 14px; -fx-text-fill: #1e293b;"
                                                       text="05/01/2026" />
                                            </children>
                                        </VBox>
                                    </children>
                                    <padding><Insets top="16.0" bottom="16.0" left="28.0" right="28.0" /></padding>
                                </HBox>

                            </children>
                        </VBox>

                        <Separator />

                        <!-- PULSANTI (stile seconda bozza) -->
                        <VBox spacing="10.0">
                            <children>
                                <!-- Modifica Dati -->
                                <Button fx:id="btnModifica" maxWidth="Infinity" onAction="#gestisciModificaProfilo"
                                        style="-fx-background-color: white; -fx-border-color: #0284c7; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #0284c7; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12px;"
                                        text="✏  MODIFICA DATI" />
                                <!-- Torna Indietro -->
                                <Button fx:id="btnTornaIndietro" maxWidth="Infinity" onAction="#tornaAllaDashboard"
                                        style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12px;"
                                        text="← TORNA INDIETRO" />
                            </children>
                            <padding><Insets top="22.0" bottom="28.0" left="28.0" right="28.0" /></padding>
                        </VBox>

                    </children>
                </VBox>
            </children>
            <padding><Insets top="24.0" left="40.0" right="40.0" bottom="30.0" /></padding>
        </VBox>

    </children>
</VBox>
