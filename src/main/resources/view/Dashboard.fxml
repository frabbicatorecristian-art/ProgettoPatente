<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    =================================================================================
    INTESTAZIONE XML E IMPORTAZIONI JAVAFX (SCHERMATA DASHBOARD PRINCIPALE)
    =================================================================================
    - <?xml version="1.0" encoding="UTF-8"?>: Codifica caratteri standard UTF-8.
    - <?import javafx.geometry.*?>: Importa tutte le classi per la gestione di margini e allineamenti (Insets, ecc.).
    - <?import javafx.scene.control.*?>: Importa i controlli dell'interfaccia (Button, Label, ScrollPane, MenuButton, MenuItem, ecc.).
    - <?import javafx.scene.layout.*?>: Importa i layout manager (VBox, HBox, StackPane, ecc.).
-->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    =================================================================================
    CONTENITORE PRINCIPALE RADICE (VBox - Dashboard)
    =================================================================================
    Struttura verticale principale che racchiude:
    1. Barra di navigazione superiore (Navbar)
    2. Area di contenuto scrollabile (ScrollPane)
    3. Barra di navigazione inferiore (Tab Bar)
    
    ATTRIBUTI UTILIZZATI:
    - alignment="TOP_CENTER": Allinea i contenuti in alto e al centro.
    - prefWidth="900.0" e prefHeight="800.0": Dimensioni preferite della finestra in pixel.
    - style="-fx-background-color: #f1f5f9;": Stile inline per impostare il colore di sfondo grigio chiaro (Tailwind Slate-100).
    - xmlns e xmlns:fx: Namespace XML ufficiali JavaFX e FXML.
    - fx:controller="controller.DashboardController": Collega la vista FXML alla classe Controller Java per la gestione dell'aula virtuale.
-->
<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="900.0" 
      stylesheets="@../css/global.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.DashboardController">

    <!-- 
        =============================================================================
        LISTA DEI COMPONENTI FIGLI (<children>)
        =============================================================================
        Racchiude tutti i nodi principali della Dashboard.
    -->
    <children>

        <!-- 
            =========================================================================
            1. BARRA DI NAVIGAZIONE SUPERIORE (NAVBAR - HBox)
            =========================================================================
            Dispone orizzontalmente il logo dell'app e il menu profilo utente.
        -->
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" minHeight="65.0" maxHeight="65.0" VBox.vgrow="NEVER" spacing="15.0" styleClass="app-navbar">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <StackPane styleClass="navbar-logo-box">
                            <children>
                                <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/car.png" /></image>
                                </ImageView>
                            </children>
                        </StackPane>
                        <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="MyPatenti" />
                    </children>
                </HBox>
                
                <!-- Spaziatore flessibile (VBox): HBox.hgrow="ALWAYS" spinge il menu utente tutto a destra -->
                <VBox HBox.hgrow="ALWAYS" />

                <!-- MENU PROFILO UTENTE (MenuButton & MenuItem) -->
                <MenuButton fx:id="menuProfilo" styleClass="app-nav-button" text="👤 Ciao, Utente">
                    <items>
                        <MenuItem onAction="#apriProfilo" text=" Il mio profilo">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                    <image><Image url="@../images/icons/user-account.png" /></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                        <MenuItem onAction="#gestisciLogout" text=" Esci">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                    <image><Image url="@../images/icons/enter.png" /></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </children>

            <!-- Padding interno della Navbar: 12px sopra/sotto e 25px sui lati -->
            <padding>
                <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
            </padding>
        </HBox>

        <!-- 
            =========================================================================
            2. CONTENUTO CENTRALE PRINCIPALE (Senza ScrollPane)
            =========================================================================
            VBox centrale che occupa tutto lo spazio verticale disponibile senza scorrimento.
        -->
        <VBox fx:id="contentArea" VBox.vgrow="ALWAYS" spacing="15.0" style="-fx-background-color: transparent;">
            <children>

                <!-- BANNER BENVENUTO COMPATTO -->
                <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="20.0" 
                      styleClass="dashboard-banner">
                    <children>
                        <!-- Testo di Benvenuto e Sottotitolo -->
                        <VBox alignment="CENTER_LEFT" spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblBenvenuto" styleClass="dashboard-banner-title" text="Bentornato, Cristian! 👋" wrapText="true" />
                                <Label styleClass="dashboard-banner-subtitle" text="Gestisci le tue patenti, i tuoi veicoli e consulta il materiale teorico." wrapText="true" />
                            </children>
                        </VBox>

                        <!-- Immagine car_license.png posizionata in alto a destra -->
                        <StackPane styleClass="header-deco-box">
                            <children>
                                <ImageView fitHeight="75.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/dashboard/car_license.png"/>
                                    </image>
                                </ImageView>
                            </children>
                        </StackPane>
                    </children>
                    <padding>
                        <Insets top="14.0" bottom="14.0" left="24.0" right="24.0" />
                    </padding>
                </HBox>

                
                <!-- STATISTICHE UTENTE (4 CARD IN HBox) -->
                <HBox spacing="15.0" alignment="CENTER" VBox.vgrow="NEVER">
                    <!-- Card 1: Patenti -->
                    <HBox styleClass="profile-card" alignment="CENTER_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
                        </padding>
                        <children>
                            <StackPane style="-fx-background-color: #e0f2fe; -fx-background-radius: 50%;" minWidth="50" minHeight="50" maxWidth="50" maxHeight="50">
                                <ImageView fitHeight="24" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/drivers-license_dashboard.png"/></image>
                                </ImageView>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="2.0">
                                <Label text="Patenti in tuo possesso" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                <Label fx:id="lblStatPatenti" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0284c7;" />
                                </VBox>
                        </children>
                    </HBox>
                    <!-- Card 2: Veicoli -->
                    <HBox styleClass="profile-card" alignment="CENTER_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
                        </padding>
                        <children>
                            <StackPane style="-fx-background-color: #dcfce7; -fx-background-radius: 50%;" minWidth="50" minHeight="50" maxWidth="50" maxHeight="50">
                                <ImageView fitHeight="24" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/car.png"/></image>
                                </ImageView>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="2.0">
                                <Label text="Veicoli registrati" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                <Label fx:id="lblStatVeicoli" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                                </VBox>
                        </children>
                    </HBox>
                    <!-- Card 3: Scadenze -->
                    <HBox styleClass="profile-card" alignment="CENTER_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
                        </padding>
                        <children>
                            <StackPane style="-fx-background-color: #fef3c7; -fx-background-radius: 50%;" minWidth="50" minHeight="50" maxWidth="50" maxHeight="50">
                                <ImageView fitHeight="24" preserveRatio="true">
                                    <image><Image url="@../images/theme/expired.png" /></image>
                                </ImageView>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="2.0">
                                <Label text="Scadenze prossime" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                <Label fx:id="lblStatScadenze" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #d97706;" />
                                </VBox>
                        </children>
                    </HBox>
                    <!-- Card 4: Quiz -->
                    <HBox styleClass="profile-card" alignment="CENTER_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
                        </padding>
                        <children>
                            <StackPane style="-fx-background-color: #f3e8ff; -fx-background-radius: 50%;" minWidth="50" minHeight="50" maxWidth="50" maxHeight="50">
                                <ImageView fitHeight="24" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/quiz_dashboard.png"/></image>
                                </ImageView>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="2.0">
                                <Label text="Quiz svolti" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                <Label fx:id="lblStatQuiz" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #9333ea;" />
                                </VBox>
                        </children>
                    </HBox>
                </HBox>

<!--
                    =========================================================
                    SEZIONE 4 PULSANTI DI NAVIGAZIONE PRINCIPALE (GRID 2x2 QUADRATA)
                    =========================================================
                    GridPane 2x2 contenente i 4 tastoni disposti a mo' di quadrato.
                    Si espande in verticale (VBox.vgrow="ALWAYS") occupando tutto lo spazio senza bisogno di scorrere.
                -->
                <GridPane alignment="CENTER" hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
                        <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
                    </rowConstraints>

                    <children>
                        <!-- 1. TASTONE: LE MIE PATENTI -->
                        <Button maxHeight="Infinity" maxWidth="Infinity" onAction="#apriSezionePatenti" styleClass="card-button, card-patenti">
                            <graphic>
                                <StackPane maxHeight="Infinity" maxWidth="Infinity">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" StackPane.alignment="CENTER_LEFT">
                                            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                                            <children>
                                                <StackPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0" styleClass="icon-squircle, icon-patenti">
                                                    <children>
                                                        <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                                                            <image><Image url="@../images/dashboard/drivers-license_dashboard.png" /></image>
                                                        </ImageView>
                                                    </children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="LE MIE PATENTI" />
                                                        <Label styleClass="card-subtitle" text="Visualizza le patenti attualmente in tuo possesso, le scadenze e i dettagli." wrapText="true" />
                                                    </children>
                                                    <padding><Insets right="80.0" /></padding>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <ImageView fitHeight="75.0" preserveRatio="true" StackPane.alignment="CENTER_RIGHT" translateX="-30.0">
                                            <image><Image url="@../images/vehicle/driver-license.png" /></image>
                                        </ImageView>
                                        <StackPane maxHeight="32.0" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" styleClass="arrow-circle" StackPane.alignment="BOTTOM_RIGHT">
                                            <children><Label styleClass="arrow-text" text="›" /></children>
                                            <StackPane.margin><Insets bottom="15.0" right="15.0" /></StackPane.margin>
                                        </StackPane>
                                    </children>
                                </StackPane>
                            </graphic>
                            <GridPane.columnIndex>0</GridPane.columnIndex>
                            <GridPane.rowIndex>0</GridPane.rowIndex>
                        </Button>

                        <!-- 2. TASTONE: I MIEI VEICOLI -->
                        <Button maxHeight="Infinity" maxWidth="Infinity" onAction="#apriSezioneVeicoli" styleClass="card-button, card-veicoli">
                            <graphic>
                                <StackPane maxHeight="Infinity" maxWidth="Infinity">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" StackPane.alignment="CENTER_LEFT">
                                            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                                            <children>
                                                <StackPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0" styleClass="icon-squircle, icon-veicoli">
                                                    <children>
                                                        <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                                                            <image><Image url="@../images/dashboard/car.png" /></image>
                                                        </ImageView>
                                                    </children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="I MIEI VEICOLI" />
                                                        <Label styleClass="card-subtitle" text="Visualizza e gestisci i veicoli di tua proprietà, assicurazioni e revisioni." wrapText="true" />
                                                    </children>
                                                    <padding><Insets right="80.0" /></padding>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <ImageView fitHeight="75.0" preserveRatio="true" StackPane.alignment="CENTER_RIGHT" translateX="-30.0">
                                            <image><Image url="@../images/icons/sport-car.png" /></image>
                                        </ImageView>
                                        <StackPane maxHeight="32.0" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" styleClass="arrow-circle" StackPane.alignment="BOTTOM_RIGHT">
                                            <children><Label styleClass="arrow-text" text="›" /></children>
                                            <StackPane.margin><Insets bottom="15.0" right="15.0" /></StackPane.margin>
                                        </StackPane>
                                    </children>
                                </StackPane>
                            </graphic>
                            <GridPane.columnIndex>1</GridPane.columnIndex>
                            <GridPane.rowIndex>0</GridPane.rowIndex>
                        </Button>

                        <!-- 3. TASTONE: TEORIA E MANUALE -->
                        <Button maxHeight="Infinity" maxWidth="Infinity" onAction="#apriSezioneTeoria" styleClass="card-button, card-teoria">
                            <graphic>
                                <StackPane maxHeight="Infinity" maxWidth="Infinity">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" StackPane.alignment="CENTER_LEFT">
                                            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                                            <children>
                                                <StackPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0" styleClass="icon-squircle, icon-teoria">
                                                    <children>
                                                        <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                                                            <image><Image url="@../images/dashboard/book_dashboard.png" /></image>
                                                        </ImageView>
                                                    </children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="TEORIA &amp; MANUALE" />
                                                        <Label styleClass="card-subtitle" text="Consulta i moduli teorici del Codice della Strada sempre aggiornati." wrapText="true" />
                                                    </children>
                                                    <padding><Insets right="80.0" /></padding>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <ImageView fitHeight="75.0" preserveRatio="true" StackPane.alignment="CENTER_RIGHT" translateX="-30.0">
                                            <image><Image url="@../images/dashboard/book_dashboard.png" /></image>
                                        </ImageView>
                                        <StackPane maxHeight="32.0" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" styleClass="arrow-circle" StackPane.alignment="BOTTOM_RIGHT">
                                            <children><Label styleClass="arrow-text" text="›" /></children>
                                            <StackPane.margin><Insets bottom="15.0" right="15.0" /></StackPane.margin>
                                        </StackPane>
                                    </children>
                                </StackPane>
                            </graphic>
                            <GridPane.columnIndex>0</GridPane.columnIndex>
                            <GridPane.rowIndex>1</GridPane.rowIndex>
                        </Button>

                        <!-- 4. TASTONE: QUIZ -->
                        <Button maxHeight="Infinity" maxWidth="Infinity" onAction="#apriSezioneQuiz" styleClass="card-button, card-quiz">
                            <graphic>
                                <StackPane maxHeight="Infinity" maxWidth="Infinity">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0" StackPane.alignment="CENTER_LEFT">
                                            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                                            <children>
                                                <StackPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0" styleClass="icon-squircle, icon-quiz">
                                                    <children>
                                                        <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                                                            <image><Image url="@../images/dashboard/quiz_dashboard.png" /></image>
                                                        </ImageView>
                                                    </children>
                                                </StackPane>
                                                <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label styleClass="card-title" text="QUIZ" />
                                                        <Label styleClass="card-subtitle" text="Allenati con i quiz ministeriali e verifica la tua preparazione." wrapText="true" />
                                                    </children>
                                                    <padding><Insets right="80.0" /></padding>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <ImageView fitHeight="75.0" preserveRatio="true" StackPane.alignment="CENTER_RIGHT" translateX="-30.0">
                                            <image><Image url="@../images/dashboard/quiz_dashboard.png" /></image>
                                        </ImageView>
                                        <StackPane maxHeight="32.0" maxWidth="32.0" prefHeight="32.0" prefWidth="32.0" styleClass="arrow-circle" StackPane.alignment="BOTTOM_RIGHT">
                                            <children><Label styleClass="arrow-text" text="›" /></children>
                                            <StackPane.margin><Insets bottom="15.0" right="15.0" /></StackPane.margin>
                                        </StackPane>
                                    </children>
                                </StackPane>
                            </graphic>
                            <GridPane.columnIndex>1</GridPane.columnIndex>
                            <GridPane.rowIndex>1</GridPane.rowIndex>
                        </Button>
                    </children>
                </GridPane>

            </children>
            <!-- Margini interni del contenitore centrale (padding 20px ai lati, 15px sopra e sotto) -->
            <padding>
                <Insets bottom="18.0" left="25.0" right="25.0" top="15.0" />
            </padding>
        </VBox>

        <!--
            =========================================================================
            3. BARRA DI NAVIGAZIONE INFERIORE (TAB BAR - VBox con HBox interno)
            =========================================================================
            Barra fissa posizionata in fondo allo schermo con pulsanti a scheda (Tab).
            - VBox.vgrow="NEVER": Impedisce la riduzione o l'espansione verticale della barra.
            - style="-fx-background-color: #0284c7;": Colore di sfondo blu primario.
        -->
        <VBox fx:id="barNavInferiore" alignment="CENTER" spacing="10.0"
              maxWidth="1000.0" styleClass="bottom-navigation-bar"
              VBox.vgrow="NEVER" visible="false" managed="false" minHeight="-Infinity">

            <!-- Margine per staccare la barra dal fondo dello schermo (Floating Effect) -->
            <VBox.margin>
                <Insets bottom="25.0" left="20.0" right="20.0" />
            </VBox.margin>

            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <!-- TAB HOME -->
                        <!-- Nota: Aggiungi dal controller la classe 'btn-nav-active' al tab attualmente selezionato -->
                        <Button fx:id="btnNavHome" onAction="#apriSezioneHome" text="Home" contentDisplay="TOP"
                                prefHeight="65.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-nav-mini">
                            <graphic>
                                <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/home_dashboard.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- TAB PATENTI -->
                        <Button fx:id="btnNavPatenti" onAction="#apriSezionePatenti" text="Patenti" contentDisplay="TOP"
                                prefHeight="65.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-nav-mini">
                            <graphic>
                                <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/drivers-license_dashboard.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- TAB VEICOLI -->
                        <Button fx:id="btnNavVeicoli" onAction="#apriSezioneVeicoli" text="Veicoli" contentDisplay="TOP"
                                prefHeight="65.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-nav-mini">
                            <graphic>
                                <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/car.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- TAB TEORIA -->
                        <Button fx:id="btnNavTeoria" onAction="#apriSezioneTeoria" text="Teoria" contentDisplay="TOP"
                                prefHeight="65.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-nav-mini">
                            <graphic>
                                <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/book_dashboard.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- TAB QUIZ -->
                        <Button fx:id="btnNavQuiz" onAction="#apriSezioneQuiz" text="Quiz" contentDisplay="TOP"
                                prefHeight="65.0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-nav-mini">
                            <graphic>
                                <ImageView fitWidth="26.0" fitHeight="26.0" preserveRatio="true">
                                    <image><Image url="@../images/dashboard/quiz_dashboard.png"/></image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <!-- Etichetta informativa sulla sezione corrente (lasciata invisibile come da tuo originale) -->
                <Label fx:id="lblDettaglioSezione" styleClass="info-text-dark"
                       text="Sei nella vista principale della tua Aula Virtuale MyPatenti."
                       wrapText="true" visible="false" />
            </children>

            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </VBox>

    </children>
</VBox>
