<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EsecuzioneQuizController" stylesheets="@../css/auth.css" styleClass="quiz-root">
    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 30 10 30;">
            <children>
                <Label fx:id="lblContatore" text="1 di 30" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-padding: 8 16; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 14px;" />
                <Label fx:id="lblTimer" text="20:00" style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-padding: 8 16; -fx-background-radius: 20; -fx-font-weight: bold; -fx-font-size: 14px;" />
            </children>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox alignment="CENTER" spacing="0">
            <padding>
                <Insets top="10" right="30" bottom="20" left="30" />
            </padding>
            <children>
                <HBox styleClass="quiz-execution-box" spacing="40" alignment="CENTER" maxWidth="900" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="40" right="50" bottom="40" left="50" />
                    </padding>
                    <children>
                        <!-- COLONNA TESTO E BOTTONI (A SINISTRA) -->
                        <VBox alignment="CENTER_LEFT" spacing="30" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="lblNumeroDomanda" text="Domanda 1" style="-fx-font-weight: bold; -fx-font-size: 16px;" styleClass="quiz-id-text" />
                                <Label text="-" styleClass="quiz-id-text" />
                                <Label fx:id="lblIdDomanda" text="Codice: 302" style="-fx-font-weight: bold; -fx-font-size: 14px;" styleClass="quiz-id-text" />
                            </HBox>
                            
                            <Label fx:id="lblTestoDomanda" text="Testo domanda..." wrapText="true" style="-fx-font-size: 20px;" styleClass="quiz-question-text" minHeight="80" />
                            
                            <HBox spacing="20">
                                <Button fx:id="btnVero" text="Vero" onAction="#selezionaVero" styleClass="quiz-choice-btn" />
                                <Button fx:id="btnFalso" text="Falso" onAction="#selezionaFalso" styleClass="quiz-choice-btn" />
                            </HBox>
                            
                            <VBox fx:id="boxSpiegazione" visible="false" managed="false" style="-fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;" styleClass="stat-box">
                                <Label text="Spiegazione:" style="-fx-font-weight: bold; -fx-font-size: 14px;" styleClass="quiz-id-text" />
                                <Label fx:id="lblSpiegazione" wrapText="true" style="-fx-font-size: 14px;" styleClass="quiz-question-text" />
                            </VBox>
                        </VBox>

                        <!-- COLONNA IMMAGINE (A DESTRA) -->
                        <VBox fx:id="boxImmagine" alignment="CENTER" spacing="15" minWidth="250" maxWidth="250">
                            <ImageView fx:id="imgDomanda" fitWidth="220" preserveRatio="true" />
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- BOTTOM PAGINATION -->
    <bottom>
        <VBox spacing="20" style="-fx-padding: 0 30 30 30;" alignment="CENTER">
            <!-- Paginatore Pallini -->
            <FlowPane fx:id="paginatorePane" hgap="10" vgap="10" alignment="CENTER" maxWidth="900" />
            
            <HBox alignment="CENTER_RIGHT" spacing="20" maxWidth="900">
                <Button fx:id="btnInvia" text="Invia Quiz" onAction="#consegnaQuiz" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 24; -fx-background-radius: 8; -fx-cursor: hand;" />
                <Button fx:id="btnEsci" text="Torna alla Dashboard" onAction="#esci" visible="false" managed="false" style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 24; -fx-background-radius: 8; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
