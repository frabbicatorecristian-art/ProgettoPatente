<?xml version="1.0" encoding="UTF-8"?>

<!--
    =============================================================================
    INTESTAZIONE E IMPORTAZIONI — SCHERMATA IMPOSTAZIONI
    =============================================================================
    Questa vista consente di modificare tema, preferenze dei quiz e operazioni
    sull'account. Gli import seguenti rendono disponibili i controlli JavaFX:
    - Button e MenuButton: eseguono navigazione e azioni dell'utente.
    - ComboBox e RadioButton: raccolgono preferenze selezionabili.
    - ScrollPane: mantiene accessibili tutte le sezioni anche su finestre basse.
    - VBox, HBox, StackPane e Region: organizzano contenuti e spaziatori.
-->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    CONTENITORE PRINCIPALE (VBox)
    - alignment="TOP_CENTER": dispone le sezioni partendo dall'alto e centrate.
    - prefWidth="900.0" e prefHeight="800.0": dimensioni di riferimento della vista.
    - stylesheets="@../css/style.css": collega il foglio CSS condiviso.
    - fx:controller="controller.ImpostazioniController": collega fx:id e onAction
      ai campi e ai metodi del controller Java.
    - style: applica lo sfondo grigio chiaro dell'area di lavoro.
-->
<VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="900.0"
      stylesheets="@../css/style.css"
      style="-fx-background-color: #f1f5f9;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ImpostazioniController">
    <children>

        <!--
             NAVBAR BLU SUPERIORE (HBox)
             - HBox: affianca pulsante di ritorno, spaziatore e menu profilo.
             - prefHeight="60.0": mantiene l'altezza della barra costante.
             - style: imposta lo sfondo blu #0284c7, coerente con la navigazione.
        -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0"
              style="-fx-background-color: #0284c7;">
            <children>
                <!--
                    PULSANTE TORNA ALLA DASHBOARD
                    - fx:id="btnTornaDashboard": riferimento al pulsante nel controller.
                    - onAction="#tornaAllaDashboard": richiama il metodo Java di navigazione.
                    - style: sfondo trasparente, testo bianco e cursore cliccabile.
                -->
                <Button fx:id="btnTornaDashboard" onAction="#tornaAllaDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"
                        text="← Torna alla Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <!--
                    MENU PROFILO UTENTE (MenuButton)
                    - fx:id="menuProfilo": consente al controller di accedere al menu della navbar.
                    - text="👤 Ciao, Utente": mantiene la stessa etichetta usata nella schermata Profilo.
                    - onAction="#apriProfilo": apre la schermata con i dati personali dell'utente.
                    - onAction="#apriImpostazioniMenu": non cambia schermata perché l'utente è già nelle impostazioni.
                    - onAction="#gestisciLogout": mostra la conferma e, se accettata, chiude la sessione.
                -->
                <MenuButton fx:id="menuProfilo"
                            style="-fx-background-color: #0369a1; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"
                            text="👤 Ciao, Utente">
                    <items>
                        <MenuItem onAction="#apriProfilo" text="👤 Il mio profilo" />
                        <MenuItem onAction="#apriImpostazioniMenu" text="⚙️ Impostazioni" />
                        <MenuItem onAction="#gestisciLogout" text="🚪 Esci" />
                    </items>
                </MenuButton>
            </children>
            <padding><Insets left="25.0" right="25.0" top="10.0" bottom="10.0" /></padding>
        </HBox>

        <!-- =====================================================================
             HEADER: settings.png + titolo + sottotitolo + settings_icon.png
             ===================================================================== -->
        <HBox alignment="CENTER_LEFT" spacing="16.0"
              style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 6, 0, 0, 2);">
            <children>
                <!-- Icona blu con settings.png -->
                <StackPane maxHeight="48.0" maxWidth="48.0" prefHeight="48.0" prefWidth="48.0"
                           style="-fx-background-color: #1d4ed8; -fx-background-radius: 12px;">
                    <children>
                        <ImageView fitHeight="26.0" fitWidth="26.0" preserveRatio="true">
                            <image><Image url="@../images/settings.png" /></image>
                        </ImageView>
                    </children>
                </StackPane>

                <!-- Titolo + Sottotitolo -->
                <VBox alignment="CENTER_LEFT" spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                               text="Impostazioni" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;"
                               text="Personalizza l'app in base alle tue preferenze." />
                    </children>
                </VBox>

                <!-- Immagine decorativa settings_icon.png in alto a destra -->
                <ImageView fitHeight="68.0" preserveRatio="true">
                    <image><Image url="@../images/settings_icon.png" /></image>
                </ImageView>
            </children>
            <padding><Insets left="40.0" right="30.0" top="16.0" bottom="16.0" /></padding>
        </HBox>

        <!-- =====================================================================
             CONTENUTO SCROLLABILE
             ===================================================================== -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent;"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="14.0">
                    <children>

                        <!-- =================================================
                             SEZIONE: ASPETTO (viola tenue)
                             ================================================= -->
                        <VBox style="-fx-background-color: #f5f3ff; -fx-background-radius: 14px;">
                            <children>
                                <!-- Intestazione -->
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane maxHeight="36.0" maxWidth="36.0" prefHeight="36.0" prefWidth="36.0"
                                                   style="-fx-background-color: #7c3aed; -fx-background-radius: 10px;">
                                            <children>
                                                <Label style="-fx-font-size: 19px;" text="🎨" />
                                            </children>
                                        </StackPane>
                                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                               text="Aspetto" />
                                    </children>
                                    <padding><Insets top="16.0" bottom="10.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                                <Separator />
                                <!-- Tema: Chiaro / Scuro -->
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"
                                                       text="Tema dell'app" />
                                                <!--
                                                    RadioButton per la selezione del tema
                                                    fx:id="rbChiaro" → ID per il collegamento con il controller Java
                                                    text="Chiaro" → Etichetta visibile accanto al pulsante
                                                    selected="true" → Pre-selezionato di default (tema chiaro attivo all'avvio)
                                                    onAction="#applicaTema" → Chiama il metodo applicaTema() del controller quando selezionato
                                                    <toggleGroup><ToggleGroup fx:id="tgTema" /></toggleGroup> → Crea un gruppo di selezione esclusiva (solo uno può essere selezionato)
                                                -->
                                                <HBox alignment="CENTER_LEFT" spacing="20.0">
                                                    <children>
                                                        <RadioButton fx:id="rbChiaro" styleClass="settings-radio"
                                                                     text="Chiaro" selected="true"
                                                                     onAction="#applicaTema">
                                                            <toggleGroup><ToggleGroup fx:id="tgTema" /></toggleGroup>
                                                        </RadioButton>
                                                        <!--
                                                            RadioButton per tema scuro
                                                            fx:id="rbScuro" → ID per il collegamento con il controller
                                                            toggleGroup="$tgTema" → Usa la stessa ToggleGroup creata sopra ($ prefix referenzia il fx:id)
                                                            onAction="#applicaTema" → Chiama lo stesso metodo quando selezionato
                                                        -->
                                                        <RadioButton fx:id="rbScuro" styleClass="settings-radio"
                                                                     text="Scuro" toggleGroup="$tgTema"
                                                                     onAction="#applicaTema" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <!--
                                            Icona del tema (ImageView dinamica)
                                            fx:id="imgIconaTema" → ID per il collegamento con il controller
                                            Nel controller: imgIconaTema.setImage(new Image(...)) cambia l'immagine in base al tema selezionato
                                            Mostra il sole (#fef9c3 background giallo) quando tema chiaro, la luna (#fef9c3 background) quando scuro
                                        -->
                                        <StackPane maxHeight="52.0" maxWidth="52.0" prefHeight="52.0" prefWidth="52.0"
                                                   style="-fx-background-color: #fef9c3; -fx-background-radius: 12px;">
                                            <children>
                                                <ImageView fx:id="imgIconaTema" fitHeight="32.0" fitWidth="32.0" preserveRatio="true">
                                                    <image><Image url="@../images/light.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                    </children>
                                    <padding><Insets top="12.0" bottom="16.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- =================================================
                             SEZIONE: QUIZ (verde tenue)
                             ================================================= -->
                        <VBox style="-fx-background-color: #f0fdf4; -fx-background-radius: 14px;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane maxHeight="36.0" maxWidth="36.0" prefHeight="36.0" prefWidth="36.0"
                                                   style="-fx-background-color: #16a34a; -fx-background-radius: 10px;">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                                    <image><Image url="@../images/quiz_dashboard.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                               text="Quiz" />
                                    </children>
                                    <padding><Insets top="16.0" bottom="10.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                                <Separator />
                                <HBox alignment="CENTER" spacing="16.0">
                                    <children>
                                        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <!-- Numero domande -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #334155;"
                                                               text="Numero domande predefinito" HBox.hgrow="ALWAYS" />
                                                        <!--
                                                            ComboBox per la selezione del numero di domande
                                                            fx:id="cmbNumeroDomande" → ID per il collegamento con il controller Java
                                                            prefWidth="82.0" → Larghezza preferita in pixel
                                                            Nel controller initialize(), vengono aggiunti i valori [10, 20, 30, 40]
                                                            tramite FXCollections.observableArrayList()
                                                        -->
                                                        <ComboBox fx:id="cmbNumeroDomande" prefWidth="82.0"
                                                                  style="-fx-font-size: 13px; -fx-background-radius: 8px;" />
                                                    </children>
                                                </HBox>
                                                <!-- Spiegazione errori -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #334155;"
                                                               text="Mostra spiegazione errori" HBox.hgrow="ALWAYS" />
                                                        <!--
                                                            ToggleButton per attivare/disattivare spiegazioni errori
                                                            fx:id="toggleSpiegazioneErrori" → ID per il collegamento con il controller
                                                            selected="true" → Pre-selezionato (attivo di default)
                                                            onAction="#onToggleSpiegazioneErrori" → Chiama il metodo del controller quando togglato
                                                            styleClass="toggle-switch" → Applica stile personalizzato dal CSS (style.css)
                                                        -->
                                                        <ToggleButton fx:id="toggleSpiegazioneErrori"
                                                                      styleClass="toggle-switch" selected="true"
                                                                      onAction="#onToggleSpiegazioneErrori" />
                                                    </children>
                                                </HBox>
                                                <!-- Cronometro -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #334155;"
                                                               text="Abilita cronometro" HBox.hgrow="ALWAYS" />
                                                        <!--
                                                            ToggleButton per attivare/disattivare il cronometro nei quiz
                                                            fx:id="toggleCronometro" → ID per il collegamento con il controller
                                                            selected="true" → Pre-selezionato (cronometro attivo di default)
                                                            onAction="#onToggleCronometro" → Chiama il metodo del controller quando togglato
                                                            styleClass="toggle-switch" → Applica stile personalizzato dal CSS (style.css)
                                                        -->
                                                        <ToggleButton fx:id="toggleCronometro"
                                                                      styleClass="toggle-switch" selected="true"
                                                                      onAction="#onToggleCronometro" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <!-- Icona appunti -->
                                        <StackPane maxHeight="58.0" maxWidth="58.0" prefHeight="58.0" prefWidth="58.0"
                                                   style="-fx-background-color: #dcfce7; -fx-background-radius: 12px;">
                                            <children>
                                                <ImageView fitHeight="34.0" fitWidth="34.0" preserveRatio="true">
                                                    <image><Image url="@../images/quiz_dashboard.png" /></image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                    </children>
                                    <padding><Insets top="12.0" bottom="16.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- =================================================
                             SEZIONE: ACCOUNT (rosso tenue)
                             ================================================= -->
                        <VBox style="-fx-background-color: #fff1f2; -fx-background-radius: 14px;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane maxHeight="36.0" maxWidth="36.0" prefHeight="36.0" prefWidth="36.0"
                                                   style="-fx-background-color: #dc2626; -fx-background-radius: 10px;">
                                            <children>
                                                <Label style="-fx-font-size: 19px;" text="🛡" />
                                            </children>
                                        </StackPane>
                                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"
                                               text="Account" />
                                    </children>
                                    <padding><Insets top="16.0" bottom="10.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                                <Separator />

                                <!-- Cambia password -->
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <!--
                                            Button "Cambia password"
                                            onAction="#cambiaPassword" → Chiama il metodo cambiaPassword() del controller quando clicato
                                            styleClass="settings-account-btn" → Applica stile personalizzato dal CSS
                                            maxWidth="Infinity" e HBox.hgrow="ALWAYS" → Fa espandere il pulsante orizzontalmente occupando tutto lo spazio disponibile
                                        -->
                                        <Button styleClass="settings-account-btn-small" prefWidth="160"
                                                onAction="#cambiaPassword" text="Cambia password" />
                                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 18px;" text="›" />
                                    </children>
                                    <padding><Insets top="12.0" bottom="10.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                                <Separator />

                                <!-- Elimina account -->
                                <HBox alignment="CENTER_LEFT" spacing="18.0">
                                    <children>
                                        <!--
                                            Button "Elimina account" - Operazione irreversibile
                                            onAction="#eliminaAccount" → Chiama il metodo eliminaAccount() del controller quando clicato
                                            styleClass="settings-logout-link" → Applica stile personalizzato in rosso per avvertenza
                                            maxWidth="Infinity" e HBox.hgrow="ALWAYS" → Fa espandere il pulsante orizzontalmente
                                        -->
                                        <Button styleClass="settings-logout-link-small" prefWidth="160"
                                                onAction="#eliminaAccount" text="Elimina account" />
                                        <Label style="-fx-text-fill: #ef4444; -fx-font-size: 20px;" text="🗑" />
                                    </children>
                                    <padding><Insets top="10.0" bottom="16.0" left="18.0" right="18.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                    <padding><Insets top="18.0" bottom="10.0" left="30.0" right="30.0" /></padding>
                </VBox>
            </content>
        </ScrollPane>

        <!--
            =============================================================================
            SEZIONE 4: PULSANTI GLOBALI - SALVA E ANNULLA (Footer)
            =============================================================================
            HBox orizzontale posizionato in fondo alla pagina per le azioni globali.
            - alignment="CENTER_RIGHT" → Allinea i pulsanti a destra
            - style="-fx-effect: dropshadow(...)" → Aggiunge un'ombra delicata
            Contiene:
            1. Button "Annulla" (fx:id="btnAnnullaGlobale") con onAction="#annullaImpostazioni"
            2. Button "✓ Salva impostazioni" (fx:id="btnSalvaGlobale") con onAction="#salvaImpostazioni"
        -->
        <HBox alignment="CENTER_RIGHT" spacing="14.0"
              style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 6, 0, -2, 0);">
            <children>
                <!--
                    Button "Annulla"
                    fx:id="btnAnnullaGlobale" → ID per il collegamento con il controller
                    onAction="#annullaImpostazioni" → Chiama il metodo annullaImpostazioni() del controller quando clicato
                    style="..." → CSS inline per sfondo bianco, bordo grigio, testo grigio scuro
                -->
                <Button fx:id="btnAnnullaGlobale" onAction="#annullaImpostazioni"
                        style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10px 30px;"
                        text="Annulla" />
                <!--
                    Button "✓ Salva impostazioni" (principale)
                    fx:id="btnSalvaGlobale" → ID per il collegamento con il controller
                    onAction="#salvaImpostazioni" → Chiama il metodo salvaImpostazioni() del controller quando clicato
                    style="..." → CSS inline per sfondo blu (#0284c7), testo bianco, font bold
                -->
                <Button fx:id="btnSalvaGlobale" onAction="#salvaImpostazioni"
                        style="-fx-background-color: #0284c7; -fx-background-radius: 8px; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10px 30px;"
                        text="✓ Salva impostazioni" />
            </children>
            <padding><Insets top="14.0" bottom="14.0" left="30.0" right="30.0" /></padding>
        </HBox>

    </children>
</VBox>
